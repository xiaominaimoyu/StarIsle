---
interface Props {
  snapshotAt?: string;
  sources?: { source: "github" | "gitee"; ok: boolean; error?: string }[];
}
const { snapshotAt, sources } = Astro.props;
const year = new Date().getFullYear();
---

<footer class="no-print mt-16 border-t border-border bg-surface/50">
  <div class="mx-auto flex max-w-6xl flex-col gap-4 px-4 py-8 text-sm text-text-dim md:flex-row md:items-center md:justify-between">
    <div class="flex flex-col gap-1">
      <span class="font-display text-base font-semibold text-text">✦ 星屿 StarIsle</span>
      <span>© {year} · 由本人设计与实现</span>
    </div>
    <div class="flex flex-col gap-1">
      {snapshotAt ? (
        <span>仓库数据为构建期快照,采集于 {snapshotAt}</span>
      ) : null}
      {sources && sources.length > 0 ? (
        <span>
          来源:{sources.map((s) => s.source).join(" / ")}
          {sources.some((s) => !s.ok) ? "(部分来源抓取失败,显示最近成功缓存)" : ""}
        </span>
      ) : null}
      <span>媒体与素材均为自有、授权或公版素材;来源与许可证见文档登记</span>
    </div>
    <div class="flex gap-4">
      <a class="hover:text-text focus-ring rounded" href="/projects">项目</a>
      <a class="hover:text-text focus-ring rounded" href="/resume">简历</a>
      <a class="hover:text-text focus-ring rounded" href="https://github.com" target="_blank" rel="noopener noreferrer">GitHub</a>
    </div>
  </div>
</footer>