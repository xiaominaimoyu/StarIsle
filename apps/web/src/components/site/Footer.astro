---
import SealMonogramSvg from "@/components/narrative/SealMonogramSvg";

interface Props {
  snapshotAt?: string;
  sources?: { source: "github" | "gitee"; ok: boolean; error?: string }[];
}
const { snapshotAt, sources } = Astro.props;
const year = new Date().getFullYear();
---

<footer class="public-footer no-print">
  <div class="public-footer__inner">
    <div class="public-footer__meta">
      <span class="public-footer__brand"><SealMonogramSvg className="brand-seal brand-seal--footer" variant="compact" /> 星屿 StarIsle</span>
      <span>© {year} · 由本人设计与实现</span>
    </div>
    <div class="public-footer__meta">
      {snapshotAt ? (
        <span>仓库数据为构建期快照,采集于 {snapshotAt}</span>
      ) : null}
      {sources && sources.length > 0 ? (
        <span>
          来源:{sources.map((s) => s.source).join(" / ")}
          {sources.some((s) => !s.ok) ? "(部分来源抓取失败,显示最近成功缓存)" : ""}
        </span>
      ) : null}
      <span>媒体与素材均为自有、授权或公版素材;来源与许可证见文档登记</span>
    </div>
    <div class="public-footer__links">
      <a class="focus-ring rounded" href="/projects">项目</a>
      <a class="focus-ring rounded" href="/resume">简历</a>
      <a class="focus-ring rounded" href="/contact">留言</a>
      <a class="focus-ring rounded" href="/enter">来信</a>
    </div>
  </div>
</footer>
