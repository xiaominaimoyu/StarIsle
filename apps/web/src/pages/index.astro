---
import Portal from "@/layouts/Portal.astro";
import { getCollection, render } from "astro:content";
import { featuredRepos, loadRepoSnapshot } from "@/lib/repos";
import { getPublicSiteUrl, publicSiteUrlForPath } from "@/lib/seo";
import ModuleDock from "@/components/site/ModuleDock";
import Tag from "@/components/ui/Tag";

const about = (await getCollection("about"))[0];
const aboutContent = about ? await render(about) : undefined;
const AboutContent = aboutContent?.Content;
const projects = (await getCollection("projects")).filter((p) => p.data.featured);
const snapshot = loadRepoSnapshot();
const featured = featuredRepos(snapshot).slice(0, 3);
const aboutData = about?.data ?? { name: "你的名字", role: "", tagline: "" };
const { name, role, tagline } = aboutData;
const skills = about?.data.skills ?? [];
const stripMd = (s: string) => s.replace(/[#>*_`-]/g, "");
const siteUrl = publicSiteUrlForPath(getPublicSiteUrl(import.meta.env.PUBLIC_SITE_URL));
const structuredData = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Person",
      name,
      jobTitle: role,
      description: tagline,
      ...(siteUrl ? { url: siteUrl } : {}),
    },
    {
      "@type": "WebSite",
      name: "星屿 StarIsle",
      description: tagline || "星屿 StarIsle · 个人全栈门户",
      ...(siteUrl ? { url: siteUrl } : {}),
    },
  ],
};
---

<Portal
  title="星屿 StarIsle"
  description={tagline || "星屿 StarIsle · 个人全栈门户"}
  snapshotAt={snapshot.fetchedAt ? new Date(snapshot.fetchedAt).toLocaleDateString("zh-CN") : undefined}
  sources={snapshot.sources}
>
  <script type="application/ld+json" is:inline set:html={JSON.stringify(structuredData)} />

  <section class="relative px-4 py-20 md:py-28">
    <div class="mx-auto max-w-6xl">
      <h1 class="font-display text-4xl font-semibold leading-tight text-text md:text-[clamp(2rem,1.2rem+4vw,3.05rem)]">
        你好,我是 {name}。
      </h1>
      <p class="mt-4 max-w-xl text-lg text-text-dim">{role}</p>
      <p class="mt-2 max-w-xl text-base text-text-dim">{tagline}</p>
      <div class="mt-8 flex flex-wrap gap-3">
        <a href="/projects" class="inline-flex h-12 items-center rounded-md bg-accent px-6 font-medium text-accent-foreground hover:brightness-110 focus-ring">查看项目</a>
        <a href="/resume" class="inline-flex h-12 items-center rounded-md border border-border px-6 font-medium text-text hover:border-accent/60 focus-ring">在线简历</a>
      </div>
    </div>
  </section>

  {AboutContent ? (
    <section aria-labelledby="about-title" class="mx-auto w-full max-w-6xl px-4 py-10">
      <div class="mx-auto max-w-3xl">
        <h2 id="about-title" class="mb-4 font-display text-2xl font-semibold text-text">关于我</h2>
        <div class="space-y-4 text-base leading-relaxed text-text"><AboutContent /></div>
      </div>
    </section>
  ) : null}

  <section aria-labelledby="skills-title" class="mx-auto w-full max-w-6xl px-4 py-10">
    <h2 id="skills-title" class="mb-4 font-display text-2xl font-semibold text-text">技能</h2>
    <div class="flex flex-wrap gap-2">
      {skills.length > 0 ? skills.map((skill) => <Tag tone="neutral">{skill}</Tag>) : <p class="text-sm text-text-dim">技能信息待补充。</p>}
    </div>
  </section>

  <section aria-labelledby="featured-title" class="mx-auto w-full max-w-6xl px-4 py-10">
    <div class="mb-4 flex items-center justify-between">
      <h2 id="featured-title" class="font-display text-2xl font-semibold text-text">精选项目</h2>
      <a href="/projects" class="text-sm text-accent hover:underline focus-ring">全部项目 →</a>
    </div>
    {featured.length > 0 ? (
      <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
        {featured.map((repo) => (
          <a
            href={repo.url}
            target="_blank"
            rel="noopener noreferrer"
            class="card card-hover flex h-full flex-col gap-2 p-4 focus-ring"
          >
            <span class="font-semibold text-text">{repo.name}</span>
            <p class="line-clamp-2 flex-1 text-sm text-text-dim">{repo.description ?? "暂无描述"}</p>
            <span class="text-xs text-text-dim">★ {repo.stars} · 更新于 {new Date(repo.updatedAt).toLocaleDateString("zh-CN")}</span>
          </a>
        ))}
      </div>
    ) : (
      <p class="text-sm text-text-dim">暂无精选项目数据(构建期快照为空或未配置仓库来源)。</p>
    )}
  </section>

  {projects.length > 0 ? (
    <section aria-labelledby="projects-title" class="mx-auto w-full max-w-6xl px-4 py-10">
      <h2 id="projects-title" class="sr-only">项目文章</h2>
      <div class="grid gap-4 sm:grid-cols-2">
        {projects.map((p) => (
          <a href="/projects" class="card card-hover p-4 focus-ring">
            <h3 class="font-semibold text-text">{p.data.title}</h3>
            <p class="mt-1 line-clamp-2 text-sm text-text-dim">{stripMd(p.body).slice(0, 120)}…</p>
            <div class="mt-3 flex flex-wrap gap-2">
              {p.data.tags.map((t) => <Tag tone="neutral">{t}</Tag>)}
            </div>
          </a>
        ))}
      </div>
    </section>
  ) : null}

  <div id="modules" class="mx-auto w-full max-w-6xl px-4 py-10">
    <ModuleDock />
  </div>
</Portal>

<script is:inline>
  (function () {
    try {
      var completed = sessionStorage.getItem("star-isle:enter-completed");
      if (completed === "true") return;
      var countStr = sessionStorage.getItem("star-isle:enter-redirect-count");
      var count = countStr ? parseInt(countStr, 10) : 0;
      if (count >= 1) return;
      sessionStorage.setItem("star-isle:enter-redirect-count", String(count + 1));
      window.location.assign("/enter");
    } catch (e) {
      // sessionStorage 不可用（隐私模式/禁用），降级保留当前页
    }
  })();
</script>
