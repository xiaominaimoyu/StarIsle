---
import Base from "@/layouts/Base.astro";
import AuthCard from "@/components/auth/AuthCard";
import LoginForm from "@/components/auth/LoginForm";
import SealMonogramSvg from "@/components/narrative/SealMonogramSvg";

const privateAreaEnabled = import.meta.env.PUBLIC_PRIVATE_AREA_ENABLED !== "false";
---

<Base
  title={privateAreaEnabled ? "登录 · 星屿 StarIsle" : "私人空间 · 星屿 StarIsle"}
  description={privateAreaEnabled ? "登录进入你的岛屿控制台" : "私人空间暂未开放，欢迎浏览星屿的公开作品。"}
  noindex
>
  <div class="flex min-h-dvh flex-col">
    <header class="auth-header sticky top-0 z-40 bg-bg/80 backdrop-blur">
      <div class="auth-header__inner">
        <a href="/" class="brand-lockup flex items-center gap-2 font-display text-lg font-semibold text-text focus-ring rounded">
          <SealMonogramSvg className="brand-seal" variant="compact" /> 星屿 StarIsle
        </a>
      </div>
    </header>
    <main id="main" class="auth-stage">
      <div class="auth-frame">
        <aside class="auth-frame__context" aria-label="登录提示">
          <p>STARISLE<br />SEALED ARCHIVE</p>
          <SealMonogramSvg className="auth-frame__constellation" variant="seal" />
          <p>{privateAreaEnabled ? <>身份验证后进入<br />个人控制台。</> : <>公开作品已陈列<br />私人空间尚待开启。</>}</p>
        </aside>
        <AuthCard
          title={privateAreaEnabled ? "登录 StarIsle" : "私人空间暂未开放"}
          message={privateAreaEnabled ? "进入你的岛屿控制台。" : "欢迎先浏览公开作品与简历。"}
        >
          {privateAreaEnabled ? <>
            <LoginForm client:load />
            <noscript>
              <p class="mt-4 text-sm text-text-dim">
                登录需要启用 JavaScript。你也可以
                <a href="/projects" class="underline focus-ring">先看公开项目</a>。
              </p>
            </noscript>
          </> : (
            <div class="public-actions mt-6">
              <a href="/" class="public-action public-action--primary focus-ring">返回公开主页</a>
              <a href="/projects" class="public-action focus-ring">查看项目</a>
            </div>
          )}
        </AuthCard>
      </div>
    </main>
  </div>
</Base>
