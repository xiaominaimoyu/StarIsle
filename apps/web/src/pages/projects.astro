---
import Portal from "@/layouts/Portal.astro";
import { getCollection, render } from "astro:content";
import { loadRepoSnapshot } from "@/lib/repos";
import { sortPublicRepos } from "@/lib/public-ui";
import PublicRepoGrid from "@/components/repos/PublicRepoGrid.astro";

const projectEntries = (await getCollection("projects")).sort(
  (a, b) => b.data.date.getTime() - a.data.date.getTime(),
);
const projects = await Promise.all(projectEntries.map(async (entry) => ({
  entry,
  Content: (await render(entry)).Content,
})));
const snapshot = loadRepoSnapshot();
const repos = sortPublicRepos(snapshot.repos, { source: "all", sort: "featured" });
---

<Portal
  title="项目 · 星屿 StarIsle"
  description="星屿的项目展示与 GitHub/Gitee 仓库快照"
  snapshotAt={snapshot.fetchedAt ? new Date(snapshot.fetchedAt).toLocaleDateString("zh-CN") : undefined}
  sources={snapshot.sources}
>
  <div class="mx-auto flex w-full max-w-6xl flex-col gap-10 px-4 py-12">
    <header>
      <h1 class="font-display text-2xl font-semibold text-text">项目</h1>
      <p class="mt-2 max-w-2xl text-sm text-text-dim">
        下方的仓库数据为构建期快照,采集自 GitHub / Gitee;`featured` 精选由本地清单决定。最新数据请访问来源平台。
      </p>
    </header>

    {/* 内容集合项目(长文介绍) */}
    <section aria-labelledby="essays-title" class="mx-auto w-full max-w-3xl">
      <h2 id="essays-title" class="mb-4 font-display text-2xl font-semibold text-text">项目介绍</h2>
      {projects.length === 0 ? (
        <p class="text-sm text-text-dim">暂无项目介绍内容。</p>
      ) : (
        <div class="flex flex-col gap-6">
          {projects.map(({ entry: p, Content }) => (
            <article class="card p-5">
              <div class="mb-2 flex flex-wrap items-center gap-3">
                <h3 class="text-lg font-semibold text-text">{p.data.title}</h3>
                {p.data.featured ? <span class="rounded-full border border-accent-warm/50 px-2 py-0.5 text-xs text-accent-warm">精选</span> : null}
                <span class="text-xs text-text-dim">{p.data.date.toLocaleDateString("zh-CN")}</span>
              </div>
              <div class="space-y-3 text-base leading-relaxed text-text"><Content /></div>
              <div class="mt-3 flex flex-wrap gap-2">
                {p.data.tags.map((t) => (
                  <span class="rounded-full border border-border px-2.5 py-0.5 text-xs text-text-dim">{t}</span>
                ))}
                {p.data.sourceUrl ? (
                  <a href={p.data.sourceUrl} target="_blank" rel="noopener noreferrer" class="rounded-full border border-accent/50 px-2.5 py-0.5 text-xs text-accent hover:bg-accent/10 focus-ring">
                    源码 →
                  </a>
                ) : null}
              </div>
            </article>
          ))}
        </div>
      )}
    </section>

    {/* 仓库快照区 */}
    <section aria-labelledby="repos-title" class="mx-auto w-full max-w-6xl">
      <h2 id="repos-title" class="mb-4 font-display text-2xl font-semibold text-text">仓库快照</h2>
      <PublicRepoGrid snapshot={snapshot} repos={repos} />
    </section>
  </div>
</Portal>
