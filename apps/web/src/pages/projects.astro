---
import Portal from "@/layouts/Portal.astro";
import { getCollection, render } from "astro:content";
import { loadRepoSnapshot } from "@/lib/repos";
import { sortPublicRepos } from "@/lib/public-ui";
import PublicRepoGrid from "@/components/repos/PublicRepoGrid.astro";

const projectEntries = (await getCollection("projects")).sort(
  (a, b) => b.data.date.getTime() - a.data.date.getTime(),
);
const projects = await Promise.all(projectEntries.map(async (entry) => ({
  entry,
  Content: (await render(entry)).Content,
})));
const snapshot = loadRepoSnapshot();
const repos = sortPublicRepos(snapshot.repos, { source: "all", sort: "featured" });
const isPlaceholderUrl = (value: string) => /(?:example\.com|yourname)/i.test(value);
---

<Portal
  title="项目 · 星屿 StarIsle"
  description="星屿的项目展示与 GitHub/Gitee 仓库快照"
  snapshotAt={snapshot.fetchedAt ? new Date(snapshot.fetchedAt).toLocaleDateString("zh-CN") : undefined}
  sources={snapshot.sources}
>
  <div class="editorial-container">
    <header class="page-intro">
      <div>
        <p class="featured-entry__number">NIGHT FLIGHT ARCHIVE · 02</p>
        <h1 class="page-intro__title">夜航档案</h1>
      </div>
      <p class="page-intro__description">这里收录正在持续航行的作品与工程记录。仓库数据是构建期快照，来源于 GitHub / Gitee；精选次序由本地清单维护。需要最新状态时，请循来源平台继续查阅。</p>
    </header>

    {/* 内容集合项目(长文介绍) */}
    <section aria-labelledby="essays-title" class="page-section mx-auto w-full max-w-4xl">
      <div class="mb-5 flex items-baseline justify-between gap-4 border-b border-border pb-3">
        <h2 id="essays-title" class="font-display text-2xl font-semibold text-text">航行札记</h2>
        <span class="featured-entry__number">FIELD NOTES</span>
      </div>
      {projects.length === 0 ? (
        <p class="public-empty-state">暂无项目介绍内容。</p>
      ) : (
        <div class="project-essay-list">
          {projects.map(({ entry: p, Content }) => (
            <article id={`project-${p.id}`} class="project-essay">
              <div class="project-essay__meta">
                <p>LOG {p.data.date.toLocaleDateString("zh-CN")}</p>
                {p.data.featured ? <p class="mt-2 text-accent-warm">精选记录</p> : null}
              </div>
              <div class="project-essay__body editorial-prose">
                <h3>{p.data.title}</h3>
                <div class="text-base leading-relaxed text-text"><Content /></div>
                <div class="mt-5 flex flex-wrap items-center gap-2 border-t border-border pt-4">
                {p.data.tags.map((t) => (
                  <span class="rounded-sm border border-border px-2.5 py-0.5 font-mono text-xs tracking-wide text-text-dim">{t}</span>
                ))}
                {p.data.sourceUrl && !isPlaceholderUrl(p.data.sourceUrl) ? (
                  <a href={p.data.sourceUrl} target="_blank" rel="noopener noreferrer" class="inline-flex min-h-11 items-center rounded-md px-2.5 text-xs text-accent hover:bg-accent/10 focus-ring">
                    源码 →
                  </a>
                ) : p.data.sourceUrl ? <span class="text-xs text-text-dim">源码链接待公开</span> : null}
                </div>
              </div>
            </article>
          ))}
        </div>
      )}
    </section>

    {/* 仓库快照区 */}
    <section aria-labelledby="repos-title" class="page-section mx-auto w-full max-w-6xl">
      <div class="mb-5 flex items-baseline justify-between gap-4 border-b border-border pb-3">
        <h2 id="repos-title" class="font-display text-2xl font-semibold text-text">仓库星图</h2>
        <span class="featured-entry__number">BUILD-TIME SNAPSHOT</span>
      </div>
      <PublicRepoGrid snapshot={snapshot} repos={repos} />
    </section>
  </div>
</Portal>

<style>
  .project-essay {
    scroll-margin-top: 6rem;
  }
</style>
