---
import Base from "@/layouts/Base.astro";
---

<Base title="404 · 星屿 StarIsle" description="页面不存在" noindex>
  <main id="main" class="lost-page">
    <section class="lost-page__content">
      <p class="featured-entry__number">ROUTE RECORD · UNRESOLVED</p>
      <h1 class="lost-page__code">404</h1>
      <p class="mt-5 text-lg text-text-dim">这颗星星不在航线上。</p>
      <a href="/" class="mt-6 inline-flex min-h-11 items-center rounded-md bg-accent px-6 font-medium text-accent-foreground hover:brightness-110 focus-ring">
      回到首页
      </a>
    </section>
  </main>
</Base>
