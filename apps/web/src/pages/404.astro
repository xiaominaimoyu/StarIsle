---
import Base from "@/layouts/Base.astro";
---

<Base title="404 · 星屿 StarIsle" description="页面不存在" noindex>
  <main id="main" class="flex flex-1 flex-col items-center justify-center gap-4 px-4 py-24 text-center">
    <h1 class="font-display text-7xl font-semibold text-accent">404</h1>
    <p class="text-lg text-text-dim">这颗星星不在航线上。</p>
    <a href="/" class="mt-2 inline-flex h-12 items-center rounded-md bg-accent px-6 font-medium text-accent-foreground hover:brightness-110 focus-ring">
      回到首页
    </a>
  </main>
</Base>
