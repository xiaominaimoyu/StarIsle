---
import Portal from "@/layouts/Portal.astro";
import { getCollection, render } from "astro:content";

const resume = (await getCollection("resume"))[0];
const resumeContent = resume ? await render(resume) : undefined;
const ResumeContent = resumeContent?.Content;
const data = resume?.data ?? { name: "", role: "", summary: "" };
---

<Portal title="简历 · 星屿 StarIsle" description={`${data.role} · 在线简历`}>
  <script type="application/ld+json" is:inline set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "Person",
    name: data.name,
    jobTitle: data.role,
    description: data.summary,
  })} />

  <div class="mx-auto flex w-full max-w-6xl flex-col gap-6 px-4 py-12 print-plain">
    <header class="flex flex-wrap items-start justify-between gap-4">
      <div>
        <h1 class="font-display text-2xl font-semibold text-text">{data.name}</h1>
        <p class="mt-1 text-lg text-accent">{data.role}</p>
        <p class="mt-2 max-w-xl text-base leading-relaxed text-text-dim">{data.summary}</p>
        <ul class="mt-3 flex flex-wrap gap-x-6 gap-y-1 text-sm text-text-dim">
          {data.location ? <li>{data.location}</li> : null}
          {data.email ? <li><a class="text-accent hover:underline focus-ring" href={`mailto:${data.email}`}>{data.email}</a></li> : null}
          {data.website ? <li><a class="text-accent hover:underline focus-ring" href={data.website} target="_blank" rel="noopener noreferrer">{data.website}</a></li> : null}
        </ul>
      </div>
      {/* PDF 按钮:仅在 PDF 经确认放入 public/ 后渲染 */}
      {/* <a href="/resume.pdf" class="no-print inline-flex h-11 items-center rounded-md bg-accent px-5 font-medium text-accent-foreground hover:brightness-110 focus-ring">下载 PDF</a> */}
    </header>

    {ResumeContent ? (
      <article class="mx-auto w-full max-w-3xl">
        <div class="space-y-4 text-base leading-relaxed text-text"><ResumeContent /></div>
      </article>
    ) : (
      <p class="text-sm text-text-dim">简历内容待补充。</p>
    )}
  </div>
</Portal>
