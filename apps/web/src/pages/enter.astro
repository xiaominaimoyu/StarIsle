---
import NarrativeEntry from "@/components/narrative/NarrativeEntry";
import Base from "@/layouts/Base.astro";
---

<Base
  title="开启信封 · 星屿 StarIsle"
  description="一封通往星屿公开页与私人入口的来信。"
  noindex
  chrome={false}
>
  <main id="main" class="entry-page entry-page--immersive">
    <NarrativeEntry client:load />
  </main>
</Base>

<script>
  const markEnterCompleted = () => {
    try {
      sessionStorage.setItem("star-isle:enter-completed", "true");
    } catch {
      // sessionStorage 不可用时仍允许普通文档导航。
    }
  };

  const leaveEntry = (destination: "/" | "/login") => {
    markEnterCompleted();
    window.location.assign(destination);
  };

  const handlePublicEntry = () => leaveEntry("/");
  const handlePrivateEntry = () => leaveEntry("/login");

  window.addEventListener("narrative:public-enter", handlePublicEntry);
  window.addEventListener("narrative:private-enter", handlePrivateEntry);
  (window as any).__narrativePublicEntryHandler = handlePublicEntry;
  (window as any).__narrativePrivateEntryHandler = handlePrivateEntry;
  (window as any).__narrativeEnterListenerReady = true;
</script>
