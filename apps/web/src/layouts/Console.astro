---
import Base from "./Base.astro";
import ThemeToggle from "@/components/site/ThemeToggle";
import LogoutButton from "@/components/auth/LogoutButton";

interface Props {
  title: string;
}

const { title } = Astro.props;

const items = [
  { href: "/console", label: "概览", icon: "◈" },
  { href: "/console/gallery", label: "相册", icon: "▧" },
  { href: "/console/files", label: "文件", icon: "▤" },
  { href: "/console/mail", label: "收件箱", icon: "✉" },
  { href: "/console/kb", label: "知识库", icon: "❖" },
];
---

<Base title={title} noindex chrome={false}>
  <div class="console-shell flex min-h-dvh flex-col">
    {/* 桌面侧边栏 + 顶栏 */}
    <div class="flex flex-1">
      <aside class="console-sidebar no-print sticky top-0 hidden h-dvh w-60 shrink-0 flex-col border-r border-border bg-surface/40 p-4 lg:flex">
        <a href="/" class="console-brand mb-2 flex min-h-11 items-center gap-2 rounded font-display text-lg font-semibold text-text focus-ring">
          <span aria-hidden="true" class="text-accent-warm">✦</span> 星屿
        </a>
        <p class="featured-entry__number mb-2 px-3">NIGHT FLIGHT · CONSOLE</p>
        <nav aria-label="控制台导航" class="console-nav flex flex-1 flex-col gap-1">
          {items.map((item) => (
            <a
              href={item.href}
              aria-current={Astro.url.pathname === item.href ? "page" : undefined}
              class="console-nav__link rounded-md focus-ring"
            >
              <span aria-hidden="true" class="console-nav__icon">{item.icon}</span> {item.label}
            </a>
          ))}
        </nav>
        <a href="/" class="console-return rounded-md focus-ring">
          ← 返回门户
        </a>
      </aside>

      <div class="flex min-w-0 flex-1 flex-col">
        <header class="console-header no-print sticky top-0 z-40 flex min-h-14 items-center justify-between px-4 backdrop-blur lg:px-8">
          <div class="min-w-0">
            <p class="featured-entry__number hidden sm:block">PRIVATE ARCHIVE</p>
            <h1 class="console-header__title truncate text-base font-semibold text-text">{title}</h1>
          </div>
          <div class="flex items-center gap-2">
            <ThemeToggle client:idle />
            <LogoutButton client:idle />
          </div>
        </header>
        <main id="main" class="console-main flex-1 px-4 py-6 pb-24 lg:px-8 lg:pb-6">
          <slot />
        </main>
      </div>
    </div>

    {/* 移动端底部标签栏 */}
    <nav
      aria-label="控制台导航"
      class="console-bottom-nav no-print fixed inset-x-0 bottom-0 z-40 flex border-t border-border bg-surface/95 backdrop-blur lg:hidden"
      style="padding-bottom: env(safe-area-inset-bottom)"
    >
      <a
        href="/"
        aria-label="前往公开门户"
        class="flex min-h-11 flex-1 flex-col items-center justify-center gap-0.5 py-1.5 text-xs text-text-dim focus-ring"
      >
        <span aria-hidden="true" class="text-base">✦</span>
        星
      </a>
      {items.map((item) => (
        <a
          href={item.href}
          aria-current={Astro.url.pathname === item.href ? "page" : undefined}
          class="flex min-h-11 flex-1 flex-col items-center justify-center gap-0.5 py-1.5 text-xs text-text-dim focus-ring aria-[current=page]:text-accent"
        >
          <span aria-hidden="true" class="text-base">{item.icon}</span>
          {item.label}
        </a>
      ))}
    </nav>
  </div>
</Base>
