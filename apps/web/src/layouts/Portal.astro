---
import Base from "./Base.astro";
import PublicSiteNav from "@/components/site/PublicSiteNav.astro";
import PublicThemeToggle from "@/components/site/PublicThemeToggle.astro";
import PublicBackgroundController from "@/components/background/PublicBackgroundController.astro";
import Footer from "@/components/site/Footer.astro";
import SealMonogramSvg from "@/components/narrative/SealMonogramSvg";
import { hasPlayableTracks } from "@/lib/public-ui";
import playlist from "@/site-data/playlist.json";

interface Props {
  title: string;
  description?: string;
  canonical?: string;
  noindex?: boolean;
  /** 公开页是否显示控制台入口 */
  showAuth?: boolean;
  snapshotAt?: string;
  sources?: { source: "github" | "gitee"; ok: boolean; error?: string }[];
}

const { title, description, canonical, noindex, showAuth = true, snapshotAt, sources } = Astro.props;
/** Mirrors Base.astro's gate so a ♪ button is never rendered without a player behind it. */
const showPlayer = hasPlayableTracks(playlist.tracks);
---

<Base title={title} description={description} canonical={canonical} noindex={noindex}>
  <header class="public-header no-print z-40">
    <div class="public-header__inner">
      <a href="/" class="brand-lockup focus-ring rounded" aria-label="星屿 StarIsle 首页">
        <SealMonogramSvg className="brand-seal" variant="compact" />
        <span class="brand-lockup__text">
          <strong>星屿</strong>
          <small>StarIsle</small>
        </span>
      </a>
      <div class="public-header__actions">
        <PublicSiteNav showAuth={showAuth} />
        <span class="public-toolbar">
          <PublicThemeToggle />
          <PublicBackgroundController />
          {showPlayer && (
            <button
              type="button"
              data-open-public-playlist
              aria-controls="player-dialog"
              aria-label="打开音乐播放器"
              title="音乐播放器"
              class="public-icon-button focus-ring"
            >
              <span aria-hidden="true">♪</span>
            </button>
          )}
        </span>
      </div>
    </div>
  </header>

  <main id="main" class="portal-main flex-1">
    <slot />
  </main>

  <Footer snapshotAt={snapshotAt} sources={sources} />
</Base>
