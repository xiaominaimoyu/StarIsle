---
import Base from "./Base.astro";
import PublicSiteNav from "@/components/site/PublicSiteNav.astro";
import PublicThemeToggle from "@/components/site/PublicThemeToggle.astro";
import PublicBackgroundController from "@/components/background/PublicBackgroundController.astro";
import Footer from "@/components/site/Footer.astro";

interface Props {
  title: string;
  description?: string;
  canonical?: string;
  noindex?: boolean;
  /** 公开页是否显示控制台入口 */
  showAuth?: boolean;
  snapshotAt?: string;
  sources?: { source: "github" | "gitee"; ok: boolean; error?: string }[];
}

const { title, description, canonical, noindex, showAuth = true, snapshotAt, sources } = Astro.props;
---

<Base title={title} description={description} canonical={canonical} noindex={noindex}>
  <header class="no-print sticky top-0 z-40 border-b border-border bg-bg/80 backdrop-blur">
    <div class="mx-auto flex h-16 max-w-6xl items-center justify-between gap-4 px-4">
      <a href="/" class="font-display text-lg font-semibold text-text focus-ring rounded" aria-label="星屿 StarIsle 首页">
        <span aria-hidden="true">✦</span><span class="hidden sm:inline"> 星屿 StarIsle</span>
      </a>
      <div class="flex items-center gap-1">
        <PublicSiteNav showAuth={showAuth} />
        <span class="inline-flex items-center gap-1">
          <PublicThemeToggle />
          <PublicBackgroundController />
          <button
            type="button"
            data-open-public-playlist
            aria-controls="player-dialog"
            aria-label="打开音乐播放器"
            title="音乐播放器"
            class="inline-flex size-10 items-center justify-center rounded-md text-text-dim hover:bg-surface hover:text-text focus-ring"
          >
            <span aria-hidden="true">♪</span>
          </button>
        </span>
      </div>
    </div>
  </header>

  <main id="main" class="flex-1">
    <slot />
  </main>

  <Footer snapshotAt={snapshotAt} sources={sources} />
</Base>
