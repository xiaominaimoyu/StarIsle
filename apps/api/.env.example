# 星屿 StarIsle · FastAPI 环境变量模板
# 复制为 .env 并按部署环境填写;真实 secret 绝不写入仓库。

# --- 鉴权 ---
# AUTH_JWT_SIGNING_KEY: 必填,至少 32 字节随机值(示例值仅用于本地开发)
AUTH_JWT_SIGNING_KEY=dev-only-change-me-0123456789abcdef0123456789abcdef
AUTH_JWT_ACTIVE_KID=v1
# 可选：仅验证尚未过期旧 access JWT 的 JSON 对象（最多 4 个旧 kid→secret）；不得包含当前 kid 或真实 secret。
AUTH_JWT_PREVIOUS_KEYS_JSON={}
# ADMIN_BOOTSTRAP_PASSWORD_HASH: Argon2id 哈希(不接受明文)。
# 生成:python -c "from argon2 import PasswordHasher; print(PasswordHasher().hash('your-password'))"
ADMIN_BOOTSTRAP_PASSWORD_HASH=
AUTH_ACCESS_TTL_MINUTES=15
AUTH_REFRESH_TTL_DAYS=7
COOKIE_SECURE=false

# --- 运行时数据 ---
DATA_ROOT=../data

# --- 上传限制 ---
FILE_MAX_BYTES=104857600
IMAGE_MAX_BYTES=20971520
# 对象存储总配额，默认 10 GiB；包含原件、缩略图、邮件附件与私有原始 MIME，可按磁盘容量调整。
STORAGE_QUOTA_BYTES=10737418240

# --- 邮件(Cloudflare Email Worker → FastAPI 的 HMAC 认证) ---
MAIL_HMAC_KEY=dev-only-mail-hmac-key
# 新 Worker 配置此 kid 后发送 kid 绑定 v1 签名；先上线双协议 API，再升级 Worker，最后轮换 secret。
MAIL_HMAC_ACTIVE_KID=v1
# API 专用：仅验证带 X-Mail-Key-Id 的在途新协议重试（最多 4 把旧 kid→secret）；legacy 请求永远只用 MAIL_HMAC_KEY。
MAIL_HMAC_PREVIOUS_KEYS_JSON={}
MAIL_MAX_BYTES=5242880
# 邮件保留天数；必须为大于或等于 1 的整数，默认 30。
MAIL_RETENTION_DAYS=30

# --- 幂等记录 ---
# Idempotency-Key 去重记录的保留天数；必须为大于或等于 1 的整数，默认 30。
IDEMPOTENCY_RETENTION_DAYS=30

# --- 审计事件 ---
# audit_event 最小保留天数；必须为大于或等于 1 的整数，默认 90。
AUDIT_RETENTION_DAYS=90
# audit_event 软容量行数目标；超限从最旧删起，但绝不删除登录限速窗口（5 分钟）内的行。
AUDIT_SOFT_CAP_ROWS=100000

# --- RAG / 内部模型 ---
# 宿主机直接运行 API 时，可填 http://127.0.0.1:<port>；基础 Compose 栈强制留空。
# 仅在同时使用 infra/compose/compose.yml + compose.cpu.yml 并开启 cpu profile 时，
# Compose 会覆盖为 http://llama-chat:8080 / http://llama-embed:8081，切勿在容器内填 127.0.0.1。
# 空 embedding URL 才会使用明确的离线 hash-v1 profile；非空 URL 必须配非空 model id。
LLAMA_CHAT_BASE_URL=
LLAMA_EMBED_BASE_URL=
CHAT_MODEL_ID=starisle-chat
EMBEDDING_MODEL_ID=starisle-embed
EMBEDDING_DIM=384
