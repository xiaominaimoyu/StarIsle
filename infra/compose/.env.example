# 星屿 StarIsle · Compose 拓扑变量模板
# 只放置非 secret 的入口和挂载变量。认证/JWT/HMAC/管理员 Argon2id 哈希
# 必须仅写在 apps/api/.env.example 的复制文件或生产外部 STAR_ISLE_API_ENV_FILE 中。

# 所有模式均需：已存在的、显式绝对隔离或持久运行时目录，绝不能是仓库 data/。
DATA_HOST_ROOT=D:\\star-isle-runtime
# API 与 worker 必须共享的非 secret 运行变量；Compose 会覆盖外部 API env_file 中的同名值。
MAIL_RETENTION_DAYS=30
# Idempotency-Key 去重记录的保留天数；非 secret，默认 30 天。
IDEMPOTENCY_RETENTION_DAYS=30
# audit_event 最小保留天数；仅由 worker 使用的非 secret 变量，默认 90 天。
AUDIT_RETENTION_DAYS=90
# audit_event 软容量行数目标；仅由 worker 使用的非 secret 变量，默认 100000 行。
AUDIT_SOFT_CAP_ROWS=100000
EMBEDDING_DIM=384

# local 覆盖层可选，始终绑定到 127.0.0.1。
CADDY_HOST_PORT=8080

# CPU profile 额外必需：已存在、只读的授权 GGUF 目录，绝不能是仓库 data/models。
MODEL_HOST_ROOT=D:\\star-isle-models
CHAT_MODEL_FILE=CHANGE-ME.gguf
EMBED_MODEL_FILE=CHANGE-ME.gguf
CHAT_MODEL_ID=starisle-chat
EMBEDDING_MODEL_ID=starisle-embed

# production 覆盖层必需：用真实非默认域名/邮箱和外部 API env_file 替换占位符。
STAR_ISLE_SITE_ADDRESS=portal.example.invalid
ACME_EMAIL=admin@example.invalid
STAR_ISLE_API_ENV_FILE=D:\\secure-config\\star-isle-api.env
CADDY_HTTP_HOST_PORT=80
CADDY_HTTPS_HOST_PORT=443
