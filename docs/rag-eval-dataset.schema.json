{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "StarIsle RAG evaluation dataset",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "datasetId", "kind", "corpus", "questions"],
  "properties": {
    "schemaVersion": {"const": 1},
    "datasetId": {"type": "string", "minLength": 1},
    "kind": {
      "type": "string",
      "enum": ["synthetic-smoke", "acceptance"]
    },
    "corpus": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version", "authorized", "documentIds"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1},
        "authorized": {"type": "boolean"},
        "documentIds": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        }
      }
    },
    "questions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "query"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "query": {"type": "string", "minLength": 1},
          "relevantDocumentIds": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {"type": "string", "minLength": 1}
          },
          "relevantChunkIds": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {"type": "string", "minLength": 1}
          }
        },
        "anyOf": [
          {"required": ["relevantDocumentIds"]},
          {"required": ["relevantChunkIds"]}
        ]
      }
    }
  }
}
